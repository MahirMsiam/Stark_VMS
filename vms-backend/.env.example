# Copy this file to .env (git-ignored) and fill in real values.
# Environment variables with the same names take precedence over .env.
DB_URL=jdbc:mysql://localhost:3306/stark_vms
DB_USERNAME=vms_app
DB_PASSWORD=change-me

# Optional: web origins allowed to call the API (default: any localhost port).
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Access-token signing key: at least 32 random characters. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars
# Optional: login lifetime (default 8h)
# JWT_TTL=8h

# First admin account, created at startup if it does not exist (password: 12+ characters)
ADMIN_EMAIL=admin@starkgroup.com
ADMIN_PASSWORD=change-me-please
